// Semwise database schema. Plan: docs/data-model.md.
// After editing: `pnpm db:migrate` creates and applies a migration.
//
// Every tenant-owned table has `tenantId` and a row-level security policy (added in the migration
// SQL, since Prisma does not model policies). Repositories still filter by tenantId explicitly.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Identity and access ----------

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// One college. Created by the Super Admin.
model Tenant {
  id               String                  @id @default(cuid())
  name             String
  slug             String                  @unique
  /// IANA timezone, e.g. Asia/Kathmandu. "Today" and date ranges are computed in it.
  timezone         String
  status           TenantStatus            @default(ACTIVE)
  settings         Json                    @default("{}")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  memberships      Membership[]
  auditLogs        AuditLog[]
  aiUsage          AiUsage[]
  emailLogs        EmailLog[]
  plan             TenantPlan?
  quotas           Quota[]
  programs         Program[]
  batches          Batch[]
  semesters        Semester[]
  sections         Section[]
  subjects         Subject[]
  invitations      Invitation[]
  students         StudentRecord[]
  enrollments      Enrollment[]
  classes          Class[]
  classTeachers    ClassTeacher[]
  files            FileObject[]
  syllabi          Syllabus[]
  syllabusVersions SyllabusVersion[]
  syllabusTopics   SyllabusTopic[]
  syllabusPages    SyllabusPage[]
  syllabusChanges  SyllabusChangeRequest[]
  indexedChunks    IndexedChunk[]
  classSessions    ClassSession[]
  entries          Entry[]
  entryVersions    EntryVersion[]
  entryTopics      EntryTopic[]
  approvalSettings ApprovalSetting[]
  mediaReadings    MediaReading[]

  @@map("tenants")
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

/// One account per person, across every college. Roles come from memberships.
model User {
  id               String          @id @default(cuid())
  email            String          @unique
  /// Null until an invited person sets a password.
  passwordHash     String?
  displayName      String
  status           UserStatus      @default(INVITED)
  failedLoginCount Int             @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sessions         Session[]
  memberships      Membership[]    @relation("MembershipUser")
  granted          Membership[]    @relation("MembershipGrantedBy")
  passwordResets   PasswordReset[]
  auditLogs        AuditLog[]
  aiUsage          AiUsage[]
  invitationsSent  Invitation[]    @relation("InvitationInvitedBy")
  studentRecords   StudentRecord[]
  classesTaught    ClassTeacher[]
  filesUploaded    FileObject[]

  @@map("users")
}

/// A login. Only a SHA-256 hash of the cookie token is stored. The active college lives here.
model Session {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenantId    String?
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  /// Idle expiry; pushed forward on use.
  expiresAt         DateTime
  /// Hard limit; never extended.
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  ip                String?
  userAgent         String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum Role {
  SUPER_ADMIN
  UNIVERSITY_ADMIN
  PROGRAM_ADMIN
  TEACHER
  CR
  STUDENT
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

/// A role with a scope. SUPER_ADMIN has no tenant; every other role belongs to one college,
/// and PROGRAM_ADMIN / CR are further scoped to a program or section (added with those tables).
model Membership {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  tenantId    String?
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role        Role
  /// PROGRAM_ADMIN: the program administered.
  programId   String?
  program     Program?         @relation(fields: [programId, tenantId], references: [id, tenantId], onDelete: Cascade)
  /// CR: the section represented.
  sectionId   String?
  section     Section?         @relation(fields: [sectionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  status      MembershipStatus @default(ACTIVE)
  grantedById String?
  grantedBy   User?            @relation("MembershipGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  revokedAt   DateTime?

  @@index([userId, status])
  @@index([tenantId, role, status])
  @@map("memberships")
}

/// Single-use, expiring password reset. Only a hash of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

// ---------- Operations ----------

/// Admin actions, approvals, takedowns, syllabus and scope changes. Platform actions have no tenant.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Set when the action belongs to one program, so a Program Admin can read their own trail.
  programId  String?
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, programId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum AiFeature {
  SYLLABUS_EXTRACT
  SYLLABUS_CHANGE
  SYLLABUS_INDEX
  ENTRY_ORGANIZE
  ENTRY_INDEX
  DICTATION
  PHOTO_READ
  CHAT
  CATCHUP
}

/// One AI call. Counts and cost only; prompt and answer text are never stored here.
model AiUsage {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The person the call was made for (null for system work such as indexing).
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature      AiFeature
  /// The step inside the feature: route, answer, embed, transcribe ...
  task         String
  model        String
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  cachedTokens Int         @default(0)
  /// For transcription, billed per minute.
  audioSeconds Int         @default(0)
  costMicros   Int
  /// The PriceTable row used, so old costs can be explained after prices change.
  priceId      String?
  price        PriceTable? @relation(fields: [priceId], references: [id], onDelete: SetNull)
  /// Groups the calls of one user action (a chat question = router + answer).
  requestId    String
  createdAt    DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, userId, feature, createdAt])
  @@map("ai_usage")
}

enum PriceUnit {
  TOKENS
  MINUTES
}

/// Prices per model, updated by hand from OpenAI's pricing page. Micro-dollars per 1M tokens
/// (or per minute of audio). The newest row with effectiveFrom <= now applies.
model PriceTable {
  id            String    @id @default(cuid())
  model         String
  unit          PriceUnit @default(TOKENS)
  inputPer1M    Int       @default(0)
  outputPer1M   Int       @default(0)
  cachedPer1M   Int       @default(0)
  perMinute     Int       @default(0)
  effectiveFrom DateTime  @default(now())
  createdAt     DateTime  @default(now())
  usage         AiUsage[]

  @@index([model, effectiveFrom(sort: Desc)])
  @@map("price_table")
}

enum QuotaScope {
  USER
  TENANT
}

/// A monthly limit on a feature. A row with no tenant is the platform default; a tenant row overrides it.
/// Without any row, the defaults from the environment apply.
model Quota {
  id        String     @id @default(cuid())
  tenantId  String?
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope     QuotaScope
  feature   AiFeature
  limit     Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, scope, feature])
  @@map("quotas")
}

/// The college's plan. The monthly AI budget caps spend for the whole tenant.
model TenantPlan {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                  String   @default("pilot")
  monthlyAiBudgetMicros Int
  limits                Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("tenant_plans")
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// One outgoing email. No body and no plain address: only a hash of the recipient.
model EmailLog {
  id        String      @id @default(cuid())
  tenantId  String?
  tenant    Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template  String
  toHash    String
  status    EmailStatus @default(QUEUED)
  messageId String?
  attempts  Int         @default(0)
  error     String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("email_logs")
}

// ---------- Academic structure ----------
// Children repeat programId (and batchId, semesterId) so authorization and row-level security
// never need a join.

enum StructureStatus {
  ACTIVE
  ARCHIVED
}

model Program {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String
  status      StructureStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  batches     Batch[]
  semesters   Semester[]
  sections    Section[]
  subjects    Subject[]
  memberships Membership[]
  invitations Invitation[]
  students    StudentRecord[]
  enrollments Enrollment[]
  classes     Class[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("programs")
}

/// An intake of a program, e.g. "BIT 2026".
model Batch {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId   String
  program     Program         @relation(fields: [programId, tenantId], references: [id, tenantId], onDelete: Cascade)
  name        String
  intakeYear  Int
  status      StructureStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  semesters   Semester[]
  sections    Section[]
  subjects    Subject[]
  invitations Invitation[]
  students    StudentRecord[]
  enrollments Enrollment[]
  classes     Class[]

  @@unique([programId, name])
  @@unique([id, programId, tenantId])
  @@index([tenantId, programId])
  @@map("batches")
}

enum SemesterStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

/// Belongs to one batch (no shared semester definitions). At most one ACTIVE semester per batch.
model Semester {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId   String
  program     Program        @relation(fields: [programId, tenantId], references: [id, tenantId], onDelete: Cascade)
  batchId     String
  batch       Batch          @relation(fields: [batchId, programId, tenantId], references: [id, programId, tenantId], onDelete: Cascade)
  number      Int
  startDate   DateTime?      @db.Date
  endDate     DateTime?      @db.Date
  status      SemesterStatus @default(UPCOMING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sections    Section[]
  subjects    Subject[]
  invitations Invitation[]
  enrollments Enrollment[]
  classes     Class[]
  syllabi     Syllabus[]

  @@unique([batchId, number])
  @@unique([id, batchId, programId, tenantId])
  @@index([tenantId, batchId])
  @@map("semesters")
}

/// A group of students in one semester. Names can repeat across semesters.
model Section {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId   String
  program     Program      @relation(fields: [programId, tenantId], references: [id, tenantId], onDelete: Cascade)
  batchId     String
  batch       Batch        @relation(fields: [batchId, programId, tenantId], references: [id, programId, tenantId], onDelete: Cascade)
  semesterId  String
  semester    Semester     @relation(fields: [semesterId, batchId, programId, tenantId], references: [id, batchId, programId, tenantId], onDelete: Cascade)
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  invitations Invitation[]
  enrollments Enrollment[]
  classes     Class[]

  @@unique([semesterId, name])
  @@unique([id, tenantId])
  @@unique([id, semesterId, batchId, programId, tenantId])
  @@index([tenantId, semesterId])
  @@map("sections")
}

/// A curriculum subject of one batch's semester; each has its own syllabus.
model Subject {
  id         String          @id @default(cuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId  String
  program    Program         @relation(fields: [programId, tenantId], references: [id, tenantId], onDelete: Cascade)
  batchId    String
  batch      Batch           @relation(fields: [batchId, programId, tenantId], references: [id, programId, tenantId], onDelete: Cascade)
  semesterId String
  semester   Semester        @relation(fields: [semesterId, batchId, programId, tenantId], references: [id, batchId, programId, tenantId], onDelete: Cascade)
  name       String
  code       String
  credits    Int?
  status     StructureStatus @default(ACTIVE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  classes    Class[]
  syllabus   Syllabus?

  @@unique([semesterId, code])
  @@unique([id, semesterId, batchId, programId, tenantId])
  @@index([tenantId, semesterId])
  @@map("subjects")
}

// ---------- Invitations ----------

/// An email invite to join a college in a role. Single-use, expiring, bound to the email; only a
/// hash of the token is stored. Resending issues a new token.
model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  displayName String?
  /// Students: roll number or student ID, the second identifier.
  rollNo      String?
  role        Role
  programId   String?
  program     Program?  @relation(fields: [programId, tenantId], references: [id, tenantId], onDelete: Cascade)
  batchId     String?
  batch       Batch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  semesterId  String?
  semester    Semester? @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  sectionId   String?
  section     Section?  @relation(fields: [sectionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  invitedById String?
  invitedBy   User?     @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  /// The latest email sent for this invite (its status lives in the email log).
  emailLogId  String?
  sendCount   Int       @default(0)
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, email])
  @@index([tenantId, role, createdAt])
  @@map("invitations")
}

// ---------- Students and enrollment ----------

enum StudentStatus {
  /**
   * Invited, has not joined yet.
   */
  INVITED
  ACTIVE
  /**
   * Left the college or the invite was withdrawn; history is kept.
   */
  DEACTIVATED
}

/// A person's student identity in one college, created when they are invited (before they
/// have an account), so admins can place and correct them before they join.
model StudentRecord {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId    String
  program      Program       @relation(fields: [programId, tenantId], references: [id, tenantId], onDelete: Cascade)
  batchId      String
  batch        Batch         @relation(fields: [batchId, programId, tenantId], references: [id, programId, tenantId], onDelete: Cascade)
  /// Set when the invite is accepted.
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// The invited address (the account's email once joined).
  email        String
  displayName  String?
  rollNo       String
  status       StudentStatus @default(INVITED)
  invitationId String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  enrollments  Enrollment[]

  @@unique([tenantId, rollNo])
  @@unique([tenantId, email])
  @@unique([tenantId, userId])
  @@unique([id, batchId, tenantId])
  @@index([tenantId, batchId, status])
  @@map("student_records")
}

enum EnrollmentStatus {
  ACTIVE
  /**
   * Taken out of the semester (left, or moved before the semester began).
   */
  REMOVED
}

/// A student's section in one semester. The set of rows is the student's section history.
model Enrollment {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId       String
  program         Program          @relation(fields: [programId, tenantId], references: [id, tenantId], onDelete: Cascade)
  batchId         String
  batch           Batch            @relation(fields: [batchId, programId, tenantId], references: [id, programId, tenantId], onDelete: Cascade)
  semesterId      String
  semester        Semester         @relation(fields: [semesterId, batchId, programId, tenantId], references: [id, batchId, programId, tenantId], onDelete: Cascade)
  sectionId       String
  section         Section          @relation(fields: [sectionId, semesterId, batchId, programId, tenantId], references: [id, semesterId, batchId, programId, tenantId], onDelete: Cascade)
  studentRecordId String
  student         StudentRecord    @relation(fields: [studentRecordId, batchId, tenantId], references: [id, batchId, tenantId], onDelete: Cascade)
  status          EnrollmentStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([studentRecordId, semesterId])
  @@index([tenantId, semesterId, sectionId, status])
  @@map("enrollments")
}

// ---------- Classes ----------

/// One subject offered to one section in one semester. Needs a published syllabus.
model Class {
  id         String          @id @default(cuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId  String
  program    Program         @relation(fields: [programId, tenantId], references: [id, tenantId], onDelete: Cascade)
  batchId    String
  batch      Batch           @relation(fields: [batchId, programId, tenantId], references: [id, programId, tenantId], onDelete: Cascade)
  semesterId String
  semester   Semester        @relation(fields: [semesterId, batchId, programId, tenantId], references: [id, batchId, programId, tenantId], onDelete: Cascade)
  subjectId  String
  subject    Subject         @relation(fields: [subjectId, semesterId, batchId, programId, tenantId], references: [id, semesterId, batchId, programId, tenantId], onDelete: Cascade)
  sectionId  String
  section    Section         @relation(fields: [sectionId, semesterId, batchId, programId, tenantId], references: [id, semesterId, batchId, programId, tenantId], onDelete: Cascade)
  status     StructureStatus @default(ACTIVE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  teachers   ClassTeacher[]
  sessions   ClassSession[]
  readings   MediaReading[]

  @@unique([subjectId, sectionId])
  @@unique([id, tenantId])
  @@index([tenantId, semesterId])
  @@index([tenantId, sectionId])
  @@map("classes")
}

/// The subject teacher(s) of a class.
model ClassTeacher {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId, tenantId], references: [id, tenantId], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([classId, userId])
  @@index([tenantId, userId])
  @@map("class_teachers")
}

// ---------- Files ----------

enum FileKind {
  SYLLABUS_PDF
  AUDIO
  PHOTO
}

enum FileStatus {
  /// Upload URL issued; the bytes are not checked yet.
  PENDING
  READY
  DELETED
}

/// A file in object storage (Cloudflare R2). Key: tenants/<tenantId>/<area>/<id>.
model FileObject {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storageKey       String            @unique
  mime             String
  size             Int
  kind             FileKind
  /// What the file belongs to, for download permission checks.
  programId        String?
  batchId          String?
  semesterId       String?
  subjectId        String?
  sectionId        String?
  classId          String?
  uploadedById     String?
  uploadedBy       User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  status           FileStatus        @default(PENDING)
  deleteAfter      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  syllabusVersions SyllabusVersion[]
  reading          MediaReading?

  @@unique([id, tenantId])
  @@index([tenantId, kind, status])
  @@index([status, deleteAfter])
  @@map("files")
}

/// A voice note transcribed or a whiteboard photo read for a CR (feature 7). The CR edits the text
/// before it becomes an entry; only the person who uploaded the file can see it.
model MediaReading {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId     String
  class       Class      @relation(fields: [classId, tenantId], references: [id, tenantId], onDelete: Cascade)
  fileId      String     @unique
  file        FileObject @relation(fields: [fileId, tenantId], references: [id, tenantId], onDelete: Cascade)
  kind        FileKind
  status      JobState   @default(QUEUED)
  text        String?
  error       String?
  /// Length of a voice note in seconds (the cost is in the usage ledger).
  seconds     Int?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([id, tenantId])
  @@unique([fileId, tenantId])
  @@index([tenantId, createdById])
  @@map("media_readings")
}

// ---------- Syllabus ----------

/// The syllabus of one subject (one batch semester). subjectId stays empty while an upload
/// waits for the admin to confirm the subject the AI suggested.
model Syllabus {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId        String
  batchId          String
  semesterId       String
  semester         Semester          @relation(fields: [semesterId, batchId, programId, tenantId], references: [id, batchId, programId, tenantId], onDelete: Cascade)
  subjectId        String?           @unique
  subject          Subject?          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  /// The live (published) version; the AI only ever sees this one.
  currentVersionId String?           @unique
  currentVersion   SyllabusVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  versions         SyllabusVersion[] @relation("SyllabusVersions")

  @@unique([id, tenantId])
  @@index([tenantId, semesterId])
  @@map("syllabi")
}

enum SyllabusVersionStatus {
  DRAFT
  /// Indexing the new version; the previous one stays live until it finishes.
  PUBLISHING
  PUBLISHED
  SUPERSEDED
}

enum JobState {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// One version of a syllabus. Published versions are never changed; an edit is a new version.
model SyllabusVersion {
  id                  String                  @id @default(cuid())
  tenantId            String
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syllabusId          String
  syllabus            Syllabus                @relation("SyllabusVersions", fields: [syllabusId, tenantId], references: [id, tenantId], onDelete: Cascade)
  versionNo           Int
  status              SyllabusVersionStatus   @default(DRAFT)
  sourceFileId        String?
  sourceFile          FileObject?             @relation(fields: [sourceFileId, tenantId], references: [id, tenantId], onDelete: Restrict)
  copiedFromVersionId String?
  /// The day this version takes effect; class sessions taught from then on link to it.
  effectiveFrom       DateTime?               @db.Date
  extraction          JobState                @default(DONE)
  extractionError     String?
  /// The PDF had little text, so the AI read it as images (costs more).
  usedOcr             Boolean                 @default(false)
  suggestedName       String?
  suggestedCode       String?
  credits             Int?
  /// Reference books: [{ title, author, sourcePage }].
  references          Json                    @default("[]")
  createdById         String?
  publishedById       String?
  publishedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  liveFor             Syllabus?               @relation("CurrentVersion")
  topics              SyllabusTopic[]
  pages               SyllabusPage[]
  changeRequests      SyllabusChangeRequest[]

  @@unique([syllabusId, versionNo])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@map("syllabus_versions")
}

/// Extracted text of one PDF page, so the reviewer can see where an item came from.
model SyllabusPage {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versionId String
  version   SyllabusVersion @relation(fields: [versionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  pageNo    Int
  text      String

  @@unique([versionId, pageNo])
  @@map("syllabus_pages")
}

enum TopicKind {
  UNIT
  TOPIC
  SUBTOPIC
}

/// A node of the topic tree of a version. stableKey survives new versions of the same subject,
/// so class entries and later exam scope keep pointing at the same topic.
model SyllabusTopic {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versionId   String
  version     SyllabusVersion @relation(fields: [versionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  parentId    String?
  parent      SyllabusTopic?  @relation("TopicTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    SyllabusTopic[] @relation("TopicTree")
  stableKey   String
  kind        TopicKind
  title       String
  description String?
  /// Teaching hours given by the syllabus, if any.
  hours       Int?
  orderIndex  Int
  sourcePage  Int?
  /// 0 to 100; low values are highlighted for review.
  confidence  Int             @default(100)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([versionId, stableKey])
  @@index([tenantId, versionId])
  @@map("syllabus_topics")
}

enum ChangeRequestStatus {
  PROPOSED
  ACCEPTED
  PARTIAL
  REJECTED
}

/// A plain-language request and the changes the AI proposed for it. Nothing changes until the
/// admin accepts operations one by one.
model SyllabusChangeRequest {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versionId   String
  version     SyllabusVersion     @relation(fields: [versionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  requestText String
  /// [{ id, op, fields, before, after, decision }]
  proposedOps Json
  /// The AI note when it could not map part of the request.
  note        String?
  status      ChangeRequestStatus @default(PROPOSED)
  createdById String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime            @default(now())

  @@index([tenantId, versionId])
  @@map("syllabus_change_requests")
}

// ---------- Knowledge index ----------

enum ChunkSource {
  SYLLABUS_TOPIC
  ENTRY_VERSION
  NOTE
}

enum ChunkStatus {
  LIVE
  DELETED
}

/// Maps Postgres records to Qdrant points, so superseded vectors can always be found and removed.
model IndexedChunk {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceType       ChunkSource
  sourceId         String
  sourceVersionId  String
  ownerId          String?
  qdrantPointId    String      @unique
  embeddingModel   String
  embeddingVersion Int         @default(1)
  status           ChunkStatus @default(LIVE)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([tenantId, sourceType, sourceVersionId, status])
  @@map("indexed_chunks")
}

// ---------- Class content ----------

/// One lesson of a class on a date. Entries describe what was taught in it.
model ClassSession {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId     String
  class       Class    @relation(fields: [classId, tenantId], references: [id, tenantId], onDelete: Cascade)
  /// The day of the lesson in the college timezone (separate from created and approved times).
  taughtOn    DateTime @db.Date
  createdById String?
  createdAt   DateTime @default(now())
  entries     Entry[]

  @@unique([classId, taughtOn])
  @@unique([id, tenantId])
  @@index([tenantId, taughtOn])
  @@map("class_sessions")
}

/// What was taught in a session. Content belongs to the class, so it survives a new CR.
model Entry {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId        String
  session          ClassSession   @relation(fields: [sessionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  /// The path of the class, repeated for filtering and authorization.
  classId          String
  programId        String
  batchId          String
  semesterId       String
  sectionId        String
  subjectId        String
  taughtOn         DateTime       @db.Date
  authorId         String?
  /// The live (published) version; students and the AI only ever see this one.
  currentVersionId String?        @unique
  currentVersion   EntryVersion?  @relation("CurrentEntryVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  takenDownAt      DateTime?
  takenDownById    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  versions         EntryVersion[] @relation("EntryVersions")

  @@unique([id, tenantId])
  @@index([tenantId, sectionId, taughtOn])
  @@index([tenantId, classId, taughtOn])
  @@map("entries")
}

enum EntryVersionStatus {
  DRAFT
  /// Waiting for the subject teacher. Hidden from students.
  PENDING
  /// Approved; being indexed. The previous version stays live until it is done.
  APPROVED
  PUBLISHED
  REJECTED
  WITHDRAWN
  SUPERSEDED
}

enum InputKind {
  TEXT
  VOICE
  PHOTO
}

/// One version of an entry. Published versions never change; an edit is a new version.
model EntryVersion {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryId           String
  entry             Entry              @relation("EntryVersions", fields: [entryId, tenantId], references: [id, tenantId], onDelete: Cascade)
  versionNo         Int
  status            EntryVersionStatus @default(DRAFT)
  inputKind         InputKind          @default(TEXT)
  /// The voice transcript or photo file this text came from (feature 7).
  mediaFileId       String?
  rawText           String
  /// { topics: [{ title, subtopics, stableKey, confidence }] }
  structured        Json               @default("{}")
  summary           String?
  organize          JobState           @default(QUEUED)
  organizeError     String?
  /// The syllabus version in force on taughtOn, used for the topic mapping.
  syllabusVersionId String?
  /// The syllabus has changed since the mapping; some topics may no longer exist.
  mappingStale      Boolean            @default(false)
  authorId          String?
  /// A fix that does not change the topics (spelling, formatting): published without approval.
  minorEdit         Boolean            @default(false)
  submittedAt       DateTime?
  approvedById      String?
  decidedAt         DateTime?
  rejectionReason   String?
  /// Published automatically after the configured wait, without the teacher.
  unreviewed        Boolean            @default(false)
  reminderCount     Int                @default(0)
  lastReminderAt    DateTime?
  escalatedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  liveFor           Entry?             @relation("CurrentEntryVersion")
  topics            EntryTopic[]

  @@unique([entryId, versionNo])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@map("entry_versions")
}

/// The syllabus topics an entry version covers (by stable key, so it survives syllabus versions).
model EntryTopic {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryVersionId String
  entryVersion   EntryVersion @relation(fields: [entryVersionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  topicStableKey String
  confidence     Int

  @@unique([entryVersionId, topicStableKey])
  @@index([tenantId, topicStableKey])
  @@map("entry_topics")
}

/// Auto-approval: a program default (classId empty) and per-class overrides by the teacher.
/// A class override wins unless the program default is locked.
model ApprovalSetting {
  id                         String   @id @default(cuid())
  tenantId                   String
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId                  String
  classId                    String?  @unique
  autoApprove                Boolean
  locked                     Boolean  @default(false)
  /// Optional: publish as "not reviewed by teacher" after this many days (program only).
  unreviewedPublishAfterDays Int?
  updatedById                String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([tenantId, programId])
  @@map("approval_settings")
}
