# Copy to apps/api/.env for local development. In production these are set in Coolify.
# Values below match infra/docker-compose.dev.yml.

NODE_ENV=development
PORT=4000
# trace | debug | info | warn | error | silent
LOG_LEVEL=debug

# Origins allowed to call the API from a browser with cookies (comma-separated, exact match).
CORS_ORIGINS=http://localhost:3000
# Where links in emails point.
WEB_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the API (Coolify's proxy = 1).
TRUST_PROXY_HOPS=0

# The API and worker connect as semwise_app, which cannot bypass row-level security.
DATABASE_URL=postgresql://semwise_app:semwise_app@localhost:5434/semwise
# Migrations run as the table owner.
MIGRATION_DATABASE_URL=postgresql://semwise:semwise@localhost:5434/semwise
# Tests (wiped on every run).
TEST_DATABASE_URL=postgresql://semwise_app:semwise_app@localhost:5434/semwise_test
TEST_MIGRATION_DATABASE_URL=postgresql://semwise:semwise@localhost:5434/semwise_test

# Required. Jobs, rate limits and caches.
REDIS_URL=redis://:semwise@localhost:6380/0
TEST_REDIS_URL=redis://:semwise@localhost:6380/1

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# OpenAI. AI features answer 503 until the key is set. Model names are per task.
OPENAI_API_KEY=
AI_MODEL_ROUTER=gpt-5.6-luna
AI_MODEL_ANSWER=gpt-5.4-mini
AI_MODEL_DEEP=gpt-5.6-terra
AI_MODEL_VISION=gpt-5.6-terra
AI_MODEL_EMBEDDING=text-embedding-3-small
AI_MODEL_TRANSCRIBE=gpt-transcribe
AI_EMBEDDING_DIMENSIONS=1536

# File storage. Locally the SeaweedFS S3 endpoint; in production Cloudflare R2
# (https://<account id>.r2.cloudflarestorage.com, path style false).
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=semwise
R2_SECRET_ACCESS_KEY=semwise-secret
R2_BUCKET=semwise
R2_FORCE_PATH_STYLE=true

# Email. Locally Mailpit (read mail at http://localhost:8025). In production Gmail:
# SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURITY=starttls, an app password in SMTP_PASSWORD.
MAIL_FROM="Semwise <no-reply@semwise.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_DAILY_CAP=400
MAIL_PER_MINUTE=20
